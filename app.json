{
  "expo": {
    "name": "Rekory",
    "slug": "Rekory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ico.png",
    "scheme": "Rekory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Rekory",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ico.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Rekory",
      "usesCleartextTraffic": true,
      "splash": {
        "image": "./assets/images/adaptive-iconn.png",
        "resizeMode": "contain",
        "backgroundColor": "#151D34"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ansalmazeez",
    "extra": {
      "eas": {
        "projectId": "51276e4a-a789-4827-a76f-c28159bfc02b"
      }
    },
    "splash": {
      "image": "./assets/images/adaptive-iconn.png",
      "resizeMode": "contain",
      "backgroundColor": "#151D34"
    }
  }
}
