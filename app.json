{
  "expo": {
    "name": "Rekory",
    "slug": "Rekory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "Rekory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Rekory",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rekory uses your location only when you punch in or punch out to verify attendance."
      },
      "appleTeamId": "8V477R5F9D"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Rekory",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "splash": {
        "image": "./assets/images/adaptive-iconn.png",
        "resizeMode": "contain",
        "backgroundColor": "#151D34"
      }
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },

    "experiments": {
      "typedRoutes": true
    },

    "owner": "ansalmazeez",

    "extra": {
      "eas": {
        "projectId": "51276e4a-a789-4827-a76f-c28159bfc02b"
      }
    },

    "splash": {
      "image": "./assets/images/adaptive-iconn.png",
      "imageWidth": 120,
      "resizeMode": "contain",
      "backgroundColor": "#151D34"
    }
  }
}
