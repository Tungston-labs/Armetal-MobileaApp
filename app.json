{
  "expo": {
    "name": "ARMETAL-MBL",
    "slug": "ARMETAL-MBL",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "armetalmbl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.ARMETALMBL"
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
