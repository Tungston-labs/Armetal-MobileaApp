{
  "expo": {
    "name": "REKORY",
    "slug": "REKORY",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ico.png",
    "scheme": "REKORY",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.REKORY",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ico.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.REKORY",
      "usesCleartextTraffic": true,
      "splash":{
        "image": "./assets/images/adaptive-iconn.png",
        "resizeMode": "contain",
        "backgroundColor": "#151D34"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "ansal_m_azeez",
    "extra": {
      "eas": {
        "projectId": "49f54ba6-de00-44d7-a877-49ef5b834a94"
      }
    },
    "splash": {
      "image": "./assets/images/adaptive-iconn.png",
      "resizeMode": "contain",
      "backgroundColor": "#151D34"
    }

  }
}